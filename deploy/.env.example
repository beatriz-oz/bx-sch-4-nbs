# Settings of the deploy. new-secrets.sh copies this to .env (never committed) and fills in the secrets.

# production: real emails (Brevo), found by search engines.
# bench (test site): emails caught by Mailpit at /mail, out of search engines. Also set COMPOSE_PROFILES=bench.
DEPLOY_MODE=production
COMPOSE_PROFILES=

# Where the site answers: a domain (Caddy gets HTTPS by itself), or :80 to try it on a computer (no HTTPS).
SITE_ADDRESS=nailsbyscooby.pt
# The same address as people type it (used in emails and by the API).
PUBLIC_URL=https://nailsbyscooby.pt
# Locally, 80 is often taken: SITE_ADDRESS=:80, HTTP_PORT=8088 and PUBLIC_URL=http://localhost:8088
HTTP_PORT=80

# Database (generated)
MYSQL_DATABASE=nailsbyscooby
MYSQL_USER=nailsbyscooby
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# API secrets (generated). Changing ENCRYPTION_KEY or HASH_PEPPER later makes the stored data unreadable.
ENCRYPTION_KEY=
HASH_PEPPER=
JWT_SECRET_KEY=

# Emails. Production: fill these in (Brevo). Bench: leave them commented, Mailpit catches everything.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=Nails by Scooby <no-reply@your-domain>
STUDIO_NOTIFICATION_EMAIL=studio@nailsbyscooby.local

# Where clients send the deposit, written in the booking email (empty: "details on Instagram").
# PAYMENT_MBWAY=912345678
# PAYMENT_REVOLUT=@revolut-handle
