# Settings of the deploy. new-secrets.sh copies this to .env (never committed) and fills in the secrets.

# Where the site answers: a domain (Caddy gets HTTPS by itself), or :80 to try it on a computer (no HTTPS).
SITE_ADDRESS=nailsbyscooby-teste.duckdns.org
# The same address as people type it (used in emails and by the API).
PUBLIC_URL=https://nailsbyscooby-teste.duckdns.org
# Locally, 80 is often taken: SITE_ADDRESS=:80, HTTP_PORT=8088 and PUBLIC_URL=http://localhost:8088
HTTP_PORT=80

# Database (generated)
MYSQL_DATABASE=nailsbyscooby
MYSQL_USER=nailsbyscooby
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# API secrets (generated). Changing ENCRYPTION_KEY or HASH_PEPPER later makes the stored data unreadable.
ENCRYPTION_KEY=
HASH_PEPPER=
JWT_SECRET_KEY=

# Emails: on the test site they all go to Mailpit (/mail). For real emails (Brevo), fill these in:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=Nails by Scooby <no-reply@your-domain>
STUDIO_NOTIFICATION_EMAIL=studio@nailsbyscooby.local
